<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="create_client_table" author="gozenko.d">
        <createTable tableName="client">
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="first_name" type="varchar(30)"/>
            <column name="last_name" type="varchar(30)"/>
            <column name="middle_name" type="varchar(30)"/>
            <column name="birthday" type="date"/>
            <column name="email" type="varchar(50)"/>
            <column name="gender" type="varchar(30)"/>
            <column name="marital_status" type="varchar(30)"/>
            <column name="dependent_amount" type="int"/>
            <column name="account_number" type="varchar(30)"/>
            <column name="passport" type="jsonb"/>
            <column name="employment" type="jsonb"/>
        </createTable>
    </changeSet>

</databaseChangeLog>